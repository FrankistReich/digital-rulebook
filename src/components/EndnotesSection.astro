---
import type { MergedEndnote, ProvisionBlock } from '../lib/types';

export interface Props {
  endnotes: MergedEndnote[];
  /**
   * The article's blocks, used only to resolve `blockId → heading` so the
   * context pill can show "Abs. 1" instead of "p1". Heading lookup is
   * O(blocks); we don't bother memoizing because articles have at most a
   * few dozen blocks.
   */
  blocks: ProvisionBlock[];
}

const { endnotes, blocks } = Astro.props;

const headingByBlockId = new Map<string, string>();
for (const b of blocks) {
  if (b.id && b.heading) headingByBlockId.set(b.id, b.heading);
}
function ctxLabel(blockId: string): string {
  return headingByBlockId.get(blockId) ?? blockId ?? '';
}

/**
 * marked-footnote appends a back-ref anchor at the end of every footnote
 * `<li>`, e.g. `<a href="#fnref-en-p1-np" data-footnote-backref class="...">↩</a>`.
 * The endnote layout puts that anchor in its own grid column instead of
 * trailing the text, so we lift it out here. We don't make assumptions
 * about whether the anchor sits inside a `<p>` or directly under the `<li>`
 * — we just remove the anchor element wherever it appears.
 */
const BACK_REF_RE =
  /\s*<a\b[^>]*\bhref="#(fnref-[^"]+)"[^>]*>[\s\S]*?<\/a>\s*/i;

interface Split {
  body: string;
  backHref: string | null;
}
function splitBackRef(html: string): Split {
  const m = html.match(BACK_REF_RE);
  if (!m || m.index === undefined) return { body: html.trim(), backHref: null };
  const body = (html.slice(0, m.index) + html.slice(m.index + m[0].length)).trim();
  return { body, backHref: `#${m[1]}` };
}

const total = endnotes.length;
---
{total > 0 && (
  <section class="dr-endnotes" aria-labelledby="endnotes-heading">
    <header class="dr-endnotes__head">
      <h2 id="endnotes-heading" class="dr-endnotes__title">
        <span class="lang-en-strict">Notes</span>
        <span class="lang-zh-only">脚注汇总</span>
      </h2>
      <span class="dr-endnotes__count">
        <span class="lang-en-strict">{total} item{total === 1 ? '' : 's'}</span>
        <span class="lang-zh-only">共 {total} 条</span>
      </span>
    </header>

    <div class="dr-endnotes__grid">
      <ol class="dr-endnotes__col lang-en-only" aria-label="English notes">
        {endnotes.map((n) => {
          const half = n.en;
          if (!half) return null;
          const { body, backHref } = splitBackRef(half.contentHtml);
          return (
            <li id={half.rawId} class="dr-en-row">
              <span class="dr-en-num">{n.seqNum}</span>
              <div class="dr-en-body">
                <span class="dr-en-ctx">{ctxLabel(n.blockId)}</span>
                <span class="dr-en-text" set:html={body} />
              </div>
              {backHref ? (
                <a class="dr-fn-back" href={backHref} aria-label={`Back to reference ${n.seqNum}`}>↩</a>
              ) : <span />}
            </li>
          );
        })}
      </ol>
      <ol class="dr-endnotes__col lang-zh-only" aria-label="Chinese notes">
        {endnotes.map((n) => {
          const half = n.zh;
          if (!half) return null;
          const { body, backHref } = splitBackRef(half.contentHtml);
          return (
            <li id={half.rawId} class="dr-en-row">
              <span class="dr-en-num">{n.seqNum}</span>
              <div class="dr-en-body">
                <span class="dr-en-ctx">{ctxLabel(n.blockId)}</span>
                <span class="dr-en-text" set:html={body} />
              </div>
              {backHref ? (
                <a class="dr-fn-back" href={backHref} aria-label={`返回引用 ${n.seqNum}`}>↩</a>
              ) : <span />}
            </li>
          );
        })}
      </ol>
    </div>
  </section>
)}
